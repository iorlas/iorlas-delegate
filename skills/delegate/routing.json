      "family": "zai",
      "api": "zai-coding-plan/glm-5.3"
    },
    "glm-5.3-flash": {
      "family": "zai",
      "api": "zai-coding-plan/glm-5.3-flash"
    }
  },
  "lanes": {
    "CLAUDE_SUBSCRIPTION": {
      "family": "claude",
      "kind": "subscription",
      "reader": "claude_subscription",
      "runner": "agent_tool",
      "shared_with_orchestrator": true,
      "ready": "always"
    },
    "CLAUDE_CREDIT": {
      "family": "claude",
      "kind": "credit",
      "reader": "claude_credit",
      "runner": "claude_p",
      "ready": "claude_credit"
    },
    "OPENAI_SUBSCRIPTION": {
      "family": "openai",
      "kind": "subscription",
      "reader": "codex_app_server",
      "runner": "codex",
      "ready": "codex"
    },
    "GROK_SUBSCRIPTION": {
      "family": "xai",
      "kind": "subscription",
      "reader": "none",
      "runner": "opencode",
      "ready": "opencode_xai"
    },
    "DEEPSEEK_FREE": {
      "family": "deepseek",
      "kind": "subscription",
      "reader": "none",
      "runner": "opencode",
      "ready": "opencode_deepseek_free"
    },
    "ZAI_CODING_SUBSCRIPTION": {
      "label": "Z.ai GLM Coding Plan",
      "family": "zai",
      "kind": "subscription",
      "reader": "none",
      "runner": "opencode",
      "ready": "opencode_zai_coding"
    }
  },
  "roles": {
    "planner": {
      "about": "brainstorm, plan, design, split a ticket. Never degrades without the user's yes.",
      "advance": "on_unavailable",
      "steps": [
        {
          "model": "opus-5.5",
          "effort": "medium",
          "on": "claude",
          "cap": 3
        },
        {
          "model": "gpt-6.1-sol",
          "effort": "high",
          "on": "openai",
          "mode": "read_only",
          "use": "plan"
        }
      ],
      "degraded_needs_consent": [
        {
          "model": "opus-5.5",
          "effort": "low",
          "on": "claude",
          "cap": 3
        },
        {
          "model": "sonnet-5.5",
          "effort": "high",
          "on": "claude",
          "cap": 2
        }
      ],
      "stop": "No adequate reasoning model is available now."
    },
    "worker": {
      "about": "implement, debug, write tests.",
      "advance": "on_unavailable",
      "steps": [
        {
          "model": "deepseek-v4.1-flash-free",
          "effort": "high",
          "on": "deepseek",
          "mode": "write"
        },
        {
          "model": "glm-5.3",
          "effort": "high",
          "on": "zai",
          "mode": "write"
        },
        {
          "model": "gpt-6.1-sol",
          "effort": "medium",
          "on": "openai",
          "mode": "write",
          "use": "task"
        },
        {
          "model": "grok-4.7",
          "effort": "medium",
          "on": "xai",
          "mode": "write"
        },
        {
          "model": "sonnet-5.5",
          "effort": "medium",
          "on": "claude",
          "mode": "write",
          "cap": 2
        }
      ],
      "stop": "No worker lane is available. Hold the task; a few lines the orchestrator may write itself."
    },
    "reviewer": {
      "about": "verify, review a diff. Prefer a different family than the author (--authored-by openai|claude|xai|deepseek|zai, optional); the same family is the last resort and is flagged same_family. Codex reviews first wherever it is another family (the Pro Lite plan since 2026-10-23 has the room, and it saves the Claude limit); Grok reviews Codex's work. Always rerun the acceptance check.",
