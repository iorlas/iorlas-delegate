      "min_left_percent": 10
    },
    "credit": {
      "use_before_reset_days": 3,
      "under_cap_fraction": 0.7,
      "monthly_cap": 150,
      "reset_day": 1
    },
    "max_parallel": 4,
    "min_dwell_minutes": 30,
    "usage_stale_minutes": 30,
    "claude_weekly_reset": "",
    "deepseek_free_enabled": false,
    "zai_coding_enabled": false,
    "codex_plan_review_only": false
  },
  "models": {
    "opus-5.5": {
      "family": "claude",
      "api": "claude-opus-5-5",
      "agent": "opus"
    },
    "sonnet-5.5": {
      "family": "claude",
      "api": "claude-sonnet-5-5",
      "agent": "sonnet"
