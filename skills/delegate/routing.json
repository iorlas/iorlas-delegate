{
  "version": 1,
  "settings": {
    "orchestrator_reserve": {
      "weekly": 90,
      "five_hour": 85
    },
    "worker_lane_gate": {
      "five_hour": 90,
      "weekly": 95
    },
    "relaxed_ceiling": {
      "five_hour": 97,
      "weekly": 98,
      "orchestrator_five_hour": 95,
      "orchestrator_weekly": 95
    },
    "strain": {
      "five_hour": 80,
      "weekly_pace": -15
    },
    "recover": {
      "five_hour": 50,
      "weekly_pace": -5
    },
    "burn": {
