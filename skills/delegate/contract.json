   },
   "text": {
    "type": "string"
   },
   "say": {
    "type": "string"
   },
   "denied": {
    "type": "array"
   },
   "git_violation": {
    "type": "array"
   },
   "call_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "run_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "retry_after": {
