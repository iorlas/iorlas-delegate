     "null"
    ]
   },
   "transcript": {
    "type": [
     "string",
     "null"
    ]
   },
   "transcript_info": {
    "type": [
     "object",
     "null"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "codex",
       "claude",
       "opencode_export"
      ]
     },
     "from": {
      "type": "integer"
     },
     "to": {
      "type": "integer"
     },
     "bytes": {
      "type": "integer"
     }
    }
   },
   "usage": {
    "type": "object",
    "required": [
     "tokens",
     "cost",
     "secs",
     "turns",
     "context_k",
     "answer_bytes"
    ],
    "properties": {
     "tokens": {
      "type": [
       "object",
       "null"
      ]
     },
     "cost": {
      "type": "number"
     },
     "secs": {
      "type": "number"
     },
     "turns": {
      "type": [
       "integer",
       "null"
      ]
     },
     "context_k": {
      "type": [
       "number",
       "null"
      ]
     },
     "answer_bytes": {
      "type": "integer"
     }
    }
   },
   "stop": {
    "type": [
     "object",
     "null"
    ],
    "required": [
     "reason",
     "scope",
     "permanence",
     "retry"
    ],
    "properties": {
     "reason": {
      "type": "string"
     },
     "scope": {
      "type": "string",
